---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");

  const categoryRoutes: Record<string, string> = {
    PERFORMANCE: "performance",
    NETWORKING: "networking",
    STORAGE: "storage",
    "RAM & BIOS": "ram-bios",
    "GPU & DISPLAY": "gpu-display",
    // Mapeamentos em minúsculas para compatibilidade
    performance: "performance",
    networking: "networking",
    storage: "storage",
    "ram-bios": "ram-bios",
    "gpu-display": "gpu-display",
  };

  return articles
    .filter((article) => article.data && article.data.category)
    .map((article) => {
      const rawCategory = String(article.data.category).trim();
      
      // Tenta mapear o nome exato, em maiúsculas, ou gera um slug amigável
      const categorySlug =
        categoryRoutes[rawCategory] ||
        categoryRoutes[rawCategory.toUpperCase()] ||
        rawCategory.toLowerCase().replace(/[^a-z0-9]+/g, "-");

      return {
        params: {
          category: categorySlug,
          slug: article.id,
        },
        props: {
          article,
        },
      };
    })
    .filter((route) => Boolean(route.params.category));
}

const { article } = Astro.props;

const { Content, headings } = await render(article);

const tableOfContents = headings.filter(
  (heading) => heading.depth === 2
);
---

<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  category={article.data.category}
  categoryName={article.data.categoryName}
  categoryUrl={article.data.categoryUrl}
  updated={article.data.updated}
  headings={tableOfContents}
>
  <Content />
</ArticleLayout>